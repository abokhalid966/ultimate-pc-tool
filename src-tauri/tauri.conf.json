{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ultimate PC Tool",
  "version": "0.1.0",
  "identifier": "com.abokhalid.ultimatepctool",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ultimate PC Tool",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Monitor, command center and system manager for Windows",
    "publisher": "abokhalid",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}