{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window, the mini overlay and the clipboard picker",
  "windows": [
    "main",
    "overlay",
    "clip"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "core:window:allow-start-dragging"
  ]
